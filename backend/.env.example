# Gemini API Key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_api_key_here

# Live Model ID (defaults to gemini-2.0-flash-live)
GEMINI_MODEL=gemini-2.0-flash-live

# Gemini Voice: Kore (warm female), Puck (energetic), Charon (deep male), Fenrir (authoritative), Aoede (gentle)
GEMINI_VOICE=Kore
